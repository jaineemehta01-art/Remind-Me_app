# Remind Me - Environment Configuration Example
# Copy to .env and adjust as needed for production deployment

# Application Port
PORT=3000

# Cryptographic secret used to key session tokens (generate a strong random string in production)
SESSION_SECRET=replace_with_strong_random_secret_in_production_32_chars_minimum

# Allowed CORS Origins (comma-separated). Leave empty or specify your production domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of PBKDF2 iterations (default: 600000)
PBKDF2_ITERATIONS=600000
